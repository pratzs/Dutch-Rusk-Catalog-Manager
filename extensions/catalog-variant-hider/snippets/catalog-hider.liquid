{% comment %}
  Only inject hiding logic for active B2B customers.
  Retail visitors and customers not assigned to any catalog see everything.

  Variables expected from the block (via render tag):
    app_url  — base URL of the deployed Catalog Manager app, e.g. https://your-app.onrender.com
{% endcomment %}
{% if customer and customer.b2b? %}
  {%- comment -%}
    Get the active B2B location from the session.
  {%- endcomment -%}
  {%- assign cvh_location_id = customer.current_location.id -%}
  {%- if cvh_location_id == blank -%}
    {%- assign cvh_location_id = cart.company_location.id -%}
  {%- endif -%}
  {%- assign cvh_app_url = app_url | default: 'https://dutch-rusk-catalog-manager.onrender.com' | strip_newlines -%}

  {%- comment -%}
    ── Instant variant mask for collection pages ──────────────────────────────
    STRATEGY: CSS :not([data-cvh-processed]) hides variant pickers on every
    unprocessed card the moment the stylesheet is parsed — no JS needed to
    stamp a loading attribute. This eliminates the race between JS execution
    and browser paint, and covers infinite-scroll cards automatically since
    newly inserted DOM nodes without [data-cvh-processed] are hidden by the
    already-live CSS rule.

    catalog-variant-hider.js fetches catalog rules and sets [data-cvh-processed]
    after applying them, restoring visibility for the allowed variants only.

    Product pages are excluded ({% unless product %}) because they have no
    card containers and use a separate single-product fetch path.
  {%- endcomment -%}
  {% unless product %}
  <style id="cvh-b2b-mask">
    /*
     * This block is ONLY rendered for B2B customers — the Liquid guard above
     * ensures retail visitors never receive it.
     *
     * Strategy: hide variant pickers on ALL unprocessed cards by default using
     * :not([data-cvh-processed]). This is CSS-only — no JS attribute-stamping
     * race condition. The moment this stylesheet is parsed, every matching card
     * (including ones loaded later via infinite scroll) has its pickers hidden.
     * catalog-variant-hider.js sets [data-cvh-processed] after applying rules,
     * which restores visibility for the allowed variants only.
     */

    /* ── Layer 1a: hide while unprocessed — CSS-only, covers initial page load ─
     * Works because this <style> is parsed before the browser first paints the
     * product grid. Any card without [data-cvh-processed] is hidden immediately.
     */
    :is(.product-card, .card-wrapper, .product-card-wrapper, li.grid__item, article):not([data-cvh-processed]) input[type="radio"],
    :is(.product-card, .card-wrapper, .product-card-wrapper, li.grid__item, article):not([data-cvh-processed]) input[type="radio"] + label,
    :is(.product-card, .card-wrapper, .product-card-wrapper, li.grid__item, article):not([data-cvh-processed]) label[for],
    :is(.product-card, .card-wrapper, .product-card-wrapper, li.grid__item, article):not([data-cvh-processed]) label,
    :is(.product-card, .card-wrapper, .product-card-wrapper, li.grid__item, article):not([data-cvh-processed]) variant-selects,
    :is(.product-card, .card-wrapper, .product-card-wrapper, li.grid__item, article):not([data-cvh-processed]) fieldset,
    :is(.product-card, .card-wrapper, .product-card-wrapper, li.grid__item, article):not([data-cvh-processed]) .swatch-element,
    :is(.product-card, .card-wrapper, .product-card-wrapper, li.grid__item, article):not([data-cvh-processed]) .variant-input,
    :is(.product-card, .card-wrapper, .product-card-wrapper, li.grid__item, article):not([data-cvh-processed]) .product-form__input,
    :is(.product-card, .card-wrapper, .product-card-wrapper, li.grid__item, article):not([data-cvh-processed]) button[data-variant-id],
    :is(.product-card, .card-wrapper, .product-card-wrapper, li.grid__item, article):not([data-cvh-processed]) select[name="id"] {
      opacity: 0 !important;
      pointer-events: none !important;
      user-select: none !important;
      transition: none !important;
    }

    /* ── Layer 1b: hide while loading — JS-applied, covers infinite scroll ────
     * Infinite scroll injects new cards via JS. The browser can paint new nodes
     * before the CSS engine recalculates :not() on them. catalog-variant-hider.js
     * stamps [data-cvh-loading] synchronously in the MutationObserver callback
     * (before any await) to close that gap. This selector is intentionally broad
     * so it works even when the card container class doesn't match layer 1a.
     */
    [data-cvh-loading] input[type="radio"],
    [data-cvh-loading] input[type="radio"] + label,
    [data-cvh-loading] label[for],
    [data-cvh-loading] label,
    [data-cvh-loading] variant-selects,
    [data-cvh-loading] fieldset,
    [data-cvh-loading] .swatch-element,
    [data-cvh-loading] .variant-input,
    [data-cvh-loading] .product-form__input,
    [data-cvh-loading] button[data-variant-id],
    [data-cvh-loading] select[name="id"] {
      opacity: 0 !important;
      pointer-events: none !important;
      user-select: none !important;
      transition: none !important;
    }

    /* ── Layer 2: restore after processing ────────────────────────────────── */
    [data-cvh-processed] input[type="radio"],
    [data-cvh-processed] input[type="radio"] + label,
    [data-cvh-processed] label[for],
    [data-cvh-processed] label,
    [data-cvh-processed] variant-selects,
    [data-cvh-processed] fieldset,
    [data-cvh-processed] .swatch-element,
    [data-cvh-processed] .variant-input,
    [data-cvh-processed] .product-form__input,
    [data-cvh-processed] button[data-variant-id],
    [data-cvh-processed] select[name="id"] {
      opacity: 1 !important;
      pointer-events: auto !important;
      user-select: auto !important;
    }
  </style>
  <script>
    /* Pre-warm the Render API server (fire-and-forget).
     * Render free/starter tiers sleep after inactivity; waking it now —
     * before the deferred JS even starts — saves 10-30 s on the first
     * catalog-rules call. No card-masking needed here: the CSS above already
     * hides all unprocessed cards the moment it is parsed. */
    (function () {
      try {
        fetch(
          '{{ cvh_app_url }}/api/catalog-rules?_ping=1&shop={{ shop.permanent_domain | url_encode }}',
          { method: 'GET', mode: 'cors', cache: 'no-store' }
        ).catch(function () {});
      } catch (e) {}
    })();
  </script>
  {% endunless %}

<div
  id="catalog-variant-hider-data"
  data-app-url="{{ app_url | default: 'https://dutch-rusk-catalog-manager.onrender.com' | strip_newlines }}"
  data-location-id="{{ cvh_location_id | url_encode }}"
  data-customer-id="{{ customer.id }}"
  data-shop="{{ shop.permanent_domain }}"
  {% if product %}
    data-product-id="gid://shopify/Product/{{ product.id }}"
    data-standard-retail-price="{{ product.selected_or_first_available_variant.metafields.custom.standard_retail_price | default: product.selected_or_first_available_variant.compare_at_price | default: product.selected_or_first_available_variant.price | money_without_currency }}"
  {% endif %}
  style="display:none;"
  aria-hidden="true"
></div>
<script src="{{ 'catalog-variant-hider.js' | asset_url }}" defer></script>
{% endif %}
