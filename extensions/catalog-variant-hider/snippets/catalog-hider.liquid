{% comment %}
  Only inject hiding logic for active B2B customers.
  Retail visitors and customers not assigned to any catalog see everything.

  Variables expected from the block (via render tag):
    app_url  — base URL of the deployed Catalog Manager app, e.g. https://your-app.onrender.com
{% endcomment %}
{% if customer and customer.b2b? %}
  {%- comment -%}
    Get the active B2B location from the session.
  {%- endcomment -%}
  {%- assign cvh_location_id = customer.current_location.id -%}
  {%- if cvh_location_id == blank -%}
    {%- assign cvh_location_id = cart.company_location.id -%}
  {%- endif -%}

  {%- comment -%}
    ── Instant variant mask for collection pages ──────────────────────────────
    On collection pages the deferred JS loads AFTER the browser has already
    painted, meaning customers can see (and click) forbidden variants for
    several seconds. This server-rendered <style> + synchronous <script>
    immediately hides all variant pickers for B2B customers. The JS then
    sets [data-cvh-processed] on each card once rules have been applied,
    which this CSS uses to restore visibility for the allowed variants.
    Product pages are excluded ({% unless product %}) — they use a different
    single-product fetch path and have a different container structure.
  {%- endcomment -%}
  {% unless product %}
  <style id="cvh-b2b-mask">
    /* Hide all collection-card variant pickers until CVH JS processes each card */
    body.cvh-b2b .card-wrapper input[type="radio"],
    body.cvh-b2b .card-wrapper label[for],
    body.cvh-b2b .card-wrapper variant-selects,
    body.cvh-b2b .product-card-wrapper input[type="radio"],
    body.cvh-b2b .product-card-wrapper label[for],
    body.cvh-b2b .product-card-wrapper variant-selects,
    body.cvh-b2b li.grid__item input[type="radio"],
    body.cvh-b2b li.grid__item label[for],
    body.cvh-b2b li.grid__item variant-selects,
    body.cvh-b2b [data-product-id] input[type="radio"],
    body.cvh-b2b [data-product-id] label[for],
    body.cvh-b2b [data-product-id] button[data-variant-id] {
      opacity: 0 !important;
      pointer-events: none !important;
      user-select: none !important;
      transition: none !important;
    }
    /* Once CVH JS has processed a card, reveal the allowed variants */
    body.cvh-b2b [data-cvh-processed] input[type="radio"],
    body.cvh-b2b [data-cvh-processed] label[for],
    body.cvh-b2b [data-cvh-processed] variant-selects,
    body.cvh-b2b [data-cvh-processed] button[data-variant-id] {
      opacity: 1 !important;
      pointer-events: auto !important;
      user-select: auto !important;
    }
  </style>
  {%- comment -%}
    Synchronous (non-deferred) inline script — runs at end-of-body parse,
    BEFORE the deferred catalog-variant-hider.js fires. Adds the trigger
    class to <body> so the CSS above takes effect immediately.
  {%- endcomment -%}
  <script>document.body.classList.add('cvh-b2b');</script>
  {% endunless %}

<div
  id="catalog-variant-hider-data"
  data-app-url="{{ app_url | default: 'https://dutch-rusk-catalog-manager.onrender.com' | strip_newlines }}"
  data-location-id="{{ cvh_location_id | url_encode }}"
  data-customer-id="{{ customer.id }}"
  data-shop="{{ shop.permanent_domain }}"
  {% if product %}
    data-product-id="gid://shopify/Product/{{ product.id }}"
    data-standard-retail-price="{{ product.selected_or_first_available_variant.metafields.custom.standard_retail_price | default: product.selected_or_first_available_variant.compare_at_price | default: product.selected_or_first_available_variant.price | money_without_currency }}"
  {% endif %}
  style="display:none;"
  aria-hidden="true"
></div>
<script src="{{ 'catalog-variant-hider.js' | asset_url }}" defer></script>
{% endif %}
