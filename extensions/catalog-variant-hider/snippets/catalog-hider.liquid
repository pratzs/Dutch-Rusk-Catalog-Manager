{% comment %}
  Only inject hiding logic for active B2B customers.
  Retail visitors and customers not assigned to any catalog see everything.

  Variables expected from the block (via render tag):
    app_url  — base URL of the deployed Catalog Manager app, e.g. https://your-app.onrender.com
{% endcomment %}
{% if customer and customer.b2b? %}
  {%- comment -%}
    Try every available B2B location source in order:
    1. customer.company_location.id  (available when Shopify sets an active session location)
    2. cart.company_location.id      (available when a B2B cart is active)
    3. customer.company.locations    (fallback — pick the first assigned location)
    If all Liquid sources are blank, the JS falls back to a server-side Admin API lookup
    using customer.id so the correct catalog can still be resolved.
  {%- endcomment -%}
  {%- assign cvh_location_id = customer.company_location.id -%}
  {%- if cvh_location_id == blank -%}
    {%- assign cvh_location_id = cart.company_location.id -%}
  {%- endif -%}
  {%- if cvh_location_id == blank -%}
    {%- for loc in customer.company.locations -%}
      {%- if cvh_location_id == blank -%}{%- assign cvh_location_id = loc.id -%}{%- endif -%}
    {%- endfor -%}
  {%- endif -%}
<div
  id="catalog-variant-hider-data"
  data-app-url="{{ app_url | default: 'https://dutch-rusk-catalog-manager.onrender.com' | strip_newlines }}"
  data-location-id="{{ cvh_location_id | url_encode }}"
  data-customer-id="{{ customer.id }}"
  data-shop="{{ shop.permanent_domain }}"
  {% if product %}
    data-product-id="gid://shopify/Product/{{ product.id }}"
  {% endif %}
  style="display:none;"
  aria-hidden="true"
></div>
<script src="{{ 'catalog-variant-hider.js' | asset_url }}" defer></script>
{% endif %}
