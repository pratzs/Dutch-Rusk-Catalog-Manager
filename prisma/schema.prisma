generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Session {
  id                  String    @id
  shop                String
  state               String
  isOnline            Boolean   @default(false)
  scope               String?
  expires             DateTime?
  accessToken         String
  userId              BigInt?
  firstName           String?
  lastName            String?
  email               String?
  accountOwner        Boolean   @default(false)
  locale              String?
  collaborator        Boolean?  @default(false)
  emailVerified       Boolean?  @default(false)
  refreshToken        String?
  refreshTokenExpires DateTime?
}

model CatalogRule {
  id                  String   @id @default(cuid())
  catalogId           String
  catalogName         String
  hiddenVariantTypes  String[]
  hiddenVariantIds    String[]
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  @@unique([catalogId])
}

model ProductOverride {
  id              String   @id @default(cuid())
  catalogId       String
  productId       String
  hiddenVariantIds String[]
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@unique([catalogId, productId])
}

// Maps a Shopify CompanyLocation GID to the numeric catalog ID stored in CatalogRule.
// Populated by the catalog manager loader so the storefront extension can look up
// the correct catalog for a given logged-in B2B customer.
model LocationCatalogMap {
  id          String   @id @default(cuid())
  locationGid String   @unique
  catalogId   String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// Tracks the last-known state of each B2B price list so the 10-minute
// catalog sync can skip price lists that haven't changed (change detection).
model CatalogSyncState {
  id                   String   @id @default(cuid())
  shop                 String
  priceListId          String   // Shopify GID e.g. gid://shopify/PriceList/123
  priceListName        String   @default("")
  shopifyUpdatedAt     String   @default("") // ISO timestamp from Shopify for diffing
  adjustmentType       String   @default("") // PERCENTAGE_DECREASE | PERCENTAGE_INCREASE | FIXED_AMOUNT
  adjustmentValue      Float    @default(0)  // e.g. 20 for 20% off
  // JSON array of variant GIDs that currently have fixed-price overrides in this list.
  // Used to clean up metafields when a variant is removed from the override list.
  overriddenVariantIds String   @default("[]")
  lastSyncedAt         DateTime @default(now()) @updatedAt

  @@unique([shop, priceListId])
}