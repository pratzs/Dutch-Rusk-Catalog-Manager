generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Session {
  id                  String    @id
  shop                String
  state               String
  isOnline            Boolean   @default(false)
  scope               String?
  expires             DateTime?
  accessToken         String
  userId              BigInt?
  firstName           String?
  lastName            String?
  email               String?
  accountOwner        Boolean   @default(false)
  locale              String?
  collaborator        Boolean?  @default(false)
  emailVerified       Boolean?  @default(false)
  refreshToken        String?
  refreshTokenExpires DateTime?
}

model CatalogRule {
  id                  String   @id @default(cuid())
  catalogId           String
  catalogName         String
  hiddenVariantTypes  String[]
  hiddenVariantIds    String[]
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  @@unique([catalogId])
}

model ProductOverride {
  id              String   @id @default(cuid())
  catalogId       String
  productId       String
  hiddenVariantIds String[]
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@unique([catalogId, productId])
}

// Maps a Shopify CompanyLocation GID to the numeric catalog ID stored in CatalogRule.
// Populated by the catalog manager loader so the storefront extension can look up
// the correct catalog for a given logged-in B2B customer.
model LocationCatalogMap {
  id          String   @id @default(cuid())
  locationGid String   @unique
  catalogId   String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// Tracks the last-known state of each B2B price list so the 10-minute
// catalog sync can skip price lists that haven't changed (change detection).
model CatalogSyncState {
  id                   String   @id @default(cuid())
  shop                 String
  priceListId          String   // Shopify GID e.g. gid://shopify/PriceList/123
  priceListName        String   @default("")
  shopifyUpdatedAt     String   @default("") // ISO timestamp from Shopify for diffing
  adjustmentType       String   @default("") // PERCENTAGE_DECREASE | PERCENTAGE_INCREASE | FIXED_AMOUNT
  adjustmentValue      Float    @default(0)  // e.g. 20 for 20% off
  // JSON array of variant GIDs that currently have fixed-price overrides in this list.
  // Used to clean up metafields when a variant is removed from the override list.
  overriddenVariantIds String   @default("[]")
  lastSyncedAt         DateTime @default(now()) @updatedAt

  @@unique([shop, priceListId])
}

// One row per Django username. On Dutch Rusk a single email can own many
// B2BUser rows (10 stores -> 10 usernames -> 10 CompanyContacts on the same
// Shopify Customer). Password is bcrypt; null until the customer completes
// the invite flow.
model B2BUser {
  id                 String    @id @default(cuid())
  shop               String
  username           String
  passwordHash       String?
  email              String
  customerGid        String    // gid://shopify/Customer/...
  companyContactGid  String
  companyGid         String
  companyLocationGid String
  storeDisplayName   String
  catalogGroup       String    // "General" | "Night n Day" | "TEEG" | ...
  status             String    @default("invited") // invited | active | disabled
  lastLoginAt        DateTime?
  invitedAt          DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  @@unique([shop, username])
  @@index([shop, email])
  @@index([shop, catalogGroup])
  @@index([customerGid])
}

// Tokens for invite (initial password set) and password reset. We never store
// the raw token — only sha256(token). Single use.
model B2BPasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  purpose   String    @default("reset") // reset | invite
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
}

// Every login attempt (password + OTP) writes a row. Kept for debugging bulk
// migration issues and rate-limiting.
model B2BLoginAudit {
  id        String   @id @default(cuid())
  shop      String
  username  String?
  email     String?
  result    String   // ok | bad_password | unknown_user | disabled | oidc_error | otp_sent | otp_verified | otp_bad | rate_limited
  ip        String?
  userAgent String?
  createdAt DateTime @default(now())

  @@index([shop, createdAt])
  @@index([username])
}

// Rotating RSA keys for signing OIDC id_tokens. Multiple rows can exist
// simultaneously — /oidc/jwks.json serves all non-expired public JWKs so
// tokens signed by the previous key still verify during rotation.
model OidcSigningKey {
  id               String    @id @default(cuid())
  kid              String    @unique
  algorithm        String    @default("RS256")
  publicJwk        Json
  privateKeyEnc    String    // PEM, AES-256-GCM encrypted with APP_SECRET
  activeForSigning Boolean   @default(true)
  createdAt        DateTime  @default(now())
  rotatedAt        DateTime?
}

// Short-lived authorization code held between /oidc/authorize and /oidc/token.
// 5-minute TTL enforced by expiresAt; consumedAt prevents reuse.
model OidcAuthCode {
  id                  String    @id @default(cuid())
  code                String    @unique // 32-byte urlsafe
  b2bUserId           String
  customerGid         String
  companyLocationGid  String
  clientId            String
  redirectUri         String
  nonce               String?
  scope               String
  codeChallenge       String?
  codeChallengeMethod String?
  createdAt           DateTime  @default(now())
  expiresAt           DateTime
  consumedAt          DateTime?

  @@index([expiresAt])
}

// Opaque refresh tokens (sha256 hashed at rest). Issued alongside id_token
// during authorization_code exchange; consumed and rotated on refresh_token
// grant. 30-day sliding TTL.
model OidcRefreshToken {
  id        String    @id @default(cuid())
  tokenHash String    @unique
  b2bUserId String
  clientId  String
  scope     String
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([b2bUserId])
  @@index([expiresAt])
}

// Tracks native Shopify "Send B2B access email" sends so the go-live trigger
// (api.send-b2b-access-emails.jsx, polled by a scheduled GitHub Action) is
// idempotent — safe to call repeatedly without double-emailing a contact.
model B2BAccessEmailLog {
  id              String   @id @default(cuid())
  shop            String
  companyContactId String  @unique // gid://shopify/CompanyContact/...
  customerId      String
  email           String
  companyName     String
  status          String   // sent | failed
  error           String?
  sentAt          DateTime @default(now())

  @@index([shop])
}

// One-time email login codes (Option B path). Hashed. 10-minute TTL.
model B2BOtpCode {
  id        String    @id @default(cuid())
  b2bUserId String
  codeHash  String
  expiresAt DateTime
  usedAt    DateTime?
  attempts  Int       @default(0)
  createdAt DateTime  @default(now())

  @@index([b2bUserId])
  @@index([expiresAt])
}